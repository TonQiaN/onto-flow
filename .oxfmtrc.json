{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "_reference/",
    "data/",
    ".data/",
    ".next/",
    "node_modules/",
    "playwright-report/",
    "test-results/",
    "docs/",
    "**/*.md"
  ]
}

# Tencent Cloud web service only. Copy to
# /opt/codex-sdk-experiment/config/app.env and chmod 0600.
NODE_ENV=production
DATA_DIR=/app/data
NEXT_PUBLIC_BASE_PATH=/codex-experiment

# First release is intentionally private: the container listens through the
# Tencent host's loopback port and the Mac reaches it through an SSH tunnel.
PUBLIC_APP_URL=http://127.0.0.1:4310/codex-experiment
SESSION_COOKIE_SECURE=false
# Keep false for the direct SSH tunnel. Enable only behind a trusted reverse
# proxy that overwrites X-Real-IP.
TRUST_PROXY_HEADERS=false
TRUSTED_ORIGINS=http://127.0.0.1:4310

# Seeded administrator. Generate the bcrypt hash outside the repository.
ADMIN_USERNAME=admin
# Single quotes are required so Docker Compose does not interpolate bcrypt "$".
ADMIN_PASSWORD_HASH='$2b$12$replace_with_a_real_bcrypt_hash'

# Store only the SHA-256 hex digest of the local worker token in the cloud.
WORKER_TOKEN_SHA256=replace_with_64_lowercase_hex_characters
WORKER_LEASE_SECONDS=600
SCREENSHOT_MAX_BYTES=8388608
SCREENSHOT_MAX_WIDTH=4096
SCREENSHOT_MAX_HEIGHT=4096
SCREENSHOT_MAX_PIXELS=16777216

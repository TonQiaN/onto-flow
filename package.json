{
  "name": "codex-sdk-experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:prod",
    "setup:local": "tsx scripts/bootstrap-local-env.ts",
    "test:direct-send": "node --env-file=.env.worker.local --import tsx scripts/test-direct-codex-send.ts",
    "worker": "node --env-file=.env.worker.local --import tsx worker/index.ts",
    "worker:once": "WORKER_RUN_ONCE=true node --env-file=.env.worker.local --import tsx worker/index.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.146.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "$sharp"
    }
  }
}

# Copy to /opt/codex-sdk-experiment/config/compose.env.
# Replace the zeros with the exact 40-character Git commit used to build the
# image. Never deploy :latest or reuse a release tag.
CODEX_EXPERIMENT_IMAGE=codex-sdk-experiment:git-0000000000000000000000000000000000000000

# Keep the edge image immutable. This is the official Caddy 2.10.2 Alpine
# multi-platform image digest.
CODEX_EXPERIMENT_EDGE_IMAGE=docker.io/library/caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
CODEX_EXPERIMENT_PUBLIC_HOST=codex.82.156.249.86.nip.io

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex-sdk-experiment.maintenance</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/deploy/macos/rotate-worker-logs.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_EXPERIMENT_PROJECT_DIR</key>
    <string>__PROJECT_DIR__</string>
    <key>WORKER_LOG_KEEP_FILES</key>
    <string>5</string>
    <key>WORKER_LOG_MAX_BYTES</key>
    <string>10485760</string>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>

# Local macOS worker only. Never copy this file to Tencent Cloud.
# The LaunchAgent-managed SSH tunnel maps this Mac loopback address to the
# Tencent host loopback address. Do not use the Tencent public IP here.
WEB_APP_URL=http://127.0.0.1:4310/codex-experiment
WORKER_TOKEN=replace_with_the_raw_worker_token
WORKER_ID=fangyuanfu-mac
POLL_INTERVAL_MS=5000
WORKER_RUN_ONCE=false

# The SDK reuses the local Codex CLI ChatGPT login under CODEX_HOME.
CODEX_HOME=/Users/your-name/.codex
# Each job gets a fresh Codex thread. Its preflight and send turns share only
# that job-scoped context.
CODEX_MODEL=
CODEX_REASONING_EFFORT=high
WELINK_APP_NAME=com.huawei.cloud.welink
